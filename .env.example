# 인수인계서 AI — 환경변수 설정 예시
#
# 사용법
#   1) 이 파일을 같은 위치에 `.env`로 복사합니다.   cp .env.example .env
#   2) 아래 항목 중 이 환경에서 쓸 것만 주석을 풀고 값을 채웁니다.
#   3) 실행 전에 `.env`를 환경변수로 불러옵니다.   set -a; source .env; set +a
#      그다음 평소처럼 실행합니다.                 python run.py
#
#   실제 키와 사내 주소가 담긴 `.env`는 `.gitignore`로 제외되어 커밋되지 않습니다.
#   이 파일(`.env.example`)에는 예시 값만 두고, 실제 값은 절대 올리지 마세요.
#
# 값을 비워 두면 코드의 기본값이 쓰입니다.
# 앱은 AI 연결이 없어도 핵심 점검(빈틈 탐지·약관 조항 매칭)을 규칙 기반으로 수행합니다.


# ---------------------------------------------------------------------------
# 1) 기본값 — 데모(오프라인) 모드
# ---------------------------------------------------------------------------
# 외부로 아무것도 보내지 않고 규칙 기반으로만 동작합니다. 키 없이 바로 시연할 수 있습니다.
LLM_PROVIDER=demo


# ---------------------------------------------------------------------------
# 2) 사내 AI — 사내망·온프레미스 게이트웨이
#    화면 1단계의 "사내 AI (텍스트+그림)" / "사내 AI (텍스트만)" 모드에서 씁니다.
#    OpenAI 호환 /chat/completions 규격을 가정합니다. (app/ai_modes.py)
# ---------------------------------------------------------------------------
# 주소를 넣으면 앱이 사내 AI 모드를 기본으로 고릅니다. 주소가 없으면 호출하지 않습니다.
#INTERNAL_AI_BASE_URL=https://internal-ai.example.local/v1
#INTERNAL_AI_MODEL=internal-llm
#INTERNAL_AI_API_KEY=
#INTERNAL_AI_TIMEOUT=30


# ---------------------------------------------------------------------------
# 3) 외부 AI — OpenAI 호환 API 또는 로컬 Ollama
#    화면 1단계의 "외부 AI 연동 (민감정보 가림)" 모드에서 씁니다.
#    개인정보를 가린 사본만 이쪽으로 나갑니다. (app/llm.py)
# ---------------------------------------------------------------------------
# 3-1) OpenAI 호환 API (OpenAI, Azure 게이트웨이, vLLM 등)
#      아래 LLM_PROVIDER 줄의 주석을 풀면 위의 demo 값 대신 이 값이 쓰입니다.
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=sk-...
#LLM_TIMEOUT=30

# 3-2) 로컬 Ollama (사내망·온프레미스 시연용)
#LLM_PROVIDER=ollama
#LLM_BASE_URL=http://localhost:11434
#LLM_MODEL=llama3.1
#LLM_TIMEOUT=30
